{
  "name": "flux-monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "Framework-agnostic library for building Agentic AI-Native web applications",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "build:packages": "npm --workspaces --if-present run build",
    "publish:packages": "npm --workspaces --if-present publish --access public",
    "test": "vitest run",
    "playground": "vite playground",
    "lint": "turbo run lint"
  },
  "packageManager": "npm@10.8.2",
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^3.1.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitejs/plugin-vue": "^5.2.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "solid-js": "^1.9.15",
    "svelte": "^5.57.0",
    "turbo": "^2.0.0",
    "typescript": "^5.5.0",
    "vite-plugin-solid": "^2.11.14",
    "vitest": "^2.0.0",
    "vue": "^3.5.42"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  }
}
