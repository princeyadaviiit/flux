{
  "name": "@fluxmesh/core",
  "version": "0.1.2",
  "description": "Framework-agnostic core library for building Agentic AI-Native web applications",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./transport": {
      "types": "./dist/transport/index.d.ts",
      "import": "./dist/transport/index.mjs",
      "require": "./dist/transport/index.js"
    },
    "./state": {
      "types": "./dist/state/index.d.ts",
      "import": "./dist/state/index.mjs",
      "require": "./dist/state/index.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "lint": "eslint src"
  },
  "dependencies": {
    "dompurify": "^3.4.14",
    "fast-json-patch": "^3.1.1",
    "jsdom": "^30.0.1",
    "ws": "^8.18.0",
    "yjs": "^13.6.0"
  },
  "devDependencies": {
    "@types/dompurify": "^3.0.5",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^20.0.0",
    "@types/ws": "^8.18.1",
    "tsup": "^8.0.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  },
  "keywords": [
    "ai",
    "llm",
    "agent",
    "crdt",
    "real-time",
    "streaming"
  ],
  "author": "Flux Team",
  "license": "MIT",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  }
}
